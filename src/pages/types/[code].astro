---
import Base from '../../layouts/Base.astro';
import CharImage from '../../components/CharImage.astro';
import TypeGrid from '../../components/TypeGrid.astro';
import { AXES } from '../../lib/axes';
import { TYPES, getType, typePageUrl, type InvestorType } from '../../lib/types';

export function getStaticPaths() {
  return TYPES.map((t) => ({ params: { code: t.code.toLowerCase() }, props: { type: t } }));
}

const { type } = Astro.props as { type: InvestorType };
const compat = getType(type.compatible)!;
const letters = AXES.map((a, i) => {
  const isLeft = type.code[i] === a.left.letter;
  return { axis: a.label, letter: type.code[i], label: isLeft ? a.left.label : a.right.label, isLeft };
});

const title = `${type.code} ${type.name}の特徴・強み・弱点｜投資家16タイプ診断`;
const description = `${type.name}（${type.code}）は「${type.invest}」タイプ。日常では「${type.daily}」人。強み・やりがちな失敗・相性のいいタイプを解説します。`;
---

<Base title={title} description={description} ogImage={`/og/${type.code}.png`}>
  <nav class="pt-4 text-xs text-ink-soft" aria-label="パンくずリスト">
    <a href="/" class="underline-offset-4 hover:underline">トップ</a>
    <span class="mx-1">›</span>
    <a href="/types" class="underline-offset-4 hover:underline">16タイプ一覧</a>
    <span class="mx-1">›</span>
    <span>{type.code}</span>
  </nav>

  <section class="pt-4 text-center">
    <CharImage code={type.code} alt={type.name} sizes="(max-width: 400px) 256px, 320px" eager class="mx-auto w-56 rounded-[2rem] sm:w-72" />
    <h1 class="mt-4">
      <span class="block text-3xl font-bold tracking-widest">{type.code}</span>
      <span class="mt-1 block text-xl font-bold">{type.name}</span>
    </h1>
    <ul class="mt-4 grid grid-cols-4 gap-2">
      {letters.map((l) => (
        <li class="rounded-2xl bg-paper-deep px-1 py-2">
          <span class:list={['block text-xl font-bold', l.isLeft ? 'text-clay' : 'text-sage']}>{l.letter}</span>
          <span class="block text-xs font-bold">{l.label}</span>
          <span class="block text-[11px] text-ink-soft">{l.axis}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="mt-6 rounded-3xl bg-paper-deep px-5 py-5">
    <p class="text-xs font-bold text-ink-soft">日常のあなた</p>
    <p class="mt-1 leading-relaxed">{type.daily}</p>
    <p class="my-2 text-center text-xl text-clay" aria-hidden="true">↓</p>
    <p class="text-xs font-bold text-clay">投資したら</p>
    <p class="mt-1 text-lg font-bold leading-relaxed">{type.invest}</p>
  </section>

  <section class="mt-8">
    <h2 class="text-lg font-bold">どんなタイプ？</h2>
    <p class="mt-2 leading-loose">{type.about}</p>
  </section>

  <section class="mt-6 grid gap-3">
    <div class="rounded-3xl border border-line px-5 py-4">
      <h2 class="text-xs font-bold text-sage">強み</h2>
      <p class="mt-1">{type.strength}</p>
    </div>
    <div class="rounded-3xl border border-line px-5 py-4">
      <h2 class="text-xs font-bold text-clay">やりがちな失敗</h2>
      <p class="mt-1">{type.pitfall}</p>
    </div>
  </section>

  <section class="mt-8">
    <h2 class="text-lg font-bold">{type.name}との付き合い方</h2>
    <ol class="mt-3 space-y-2">
      {type.tips.map((tip, i) => (
        <li class="flex gap-3 rounded-2xl bg-paper-deep px-4 py-3">
          <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-clay text-xs font-bold text-paper">{i + 1}</span>
          <span>{tip}</span>
        </li>
      ))}
    </ol>
  </section>

  <section class="mt-8">
    <h2 class="text-lg font-bold">相性◎のタイプ</h2>
    <a href={typePageUrl(compat.code)} class="mt-3 flex items-center gap-4 rounded-3xl border border-line px-5 py-4">
      <CharImage code={compat.code} alt="" sizes="64px" class="size-16 shrink-0 rounded-2xl" />
      <div>
        <p class="font-bold">{compat.code} {compat.name}</p>
        <p class="text-xs text-ink-soft">時間の感覚と人混みとの距離感が同じで、攻め方と判断の根拠が逆。ペースが合い、弱点を補い合えます。</p>
      </div>
    </a>
  </section>

  <section class="mt-10 rounded-3xl bg-paper-deep px-5 py-6 text-center">
    <p class="font-bold">あなたは本当に{type.name}？</p>
    <p class="mt-1 text-sm text-ink-soft">日常の32問・約3分で分かります</p>
    <a href="/test" class="mt-4 inline-flex min-h-12 w-full max-w-xs items-center justify-center rounded-full bg-clay font-bold text-paper">診断を始める</a>
  </section>

  <section class="mt-12">
    <h2 class="text-center text-lg font-bold">ほかのタイプ</h2>
    <div class="mt-5">
      <TypeGrid current={type.code} />
    </div>
  </section>
</Base>
