---
import Base from '../layouts/Base.astro';
import CharImage from '../components/CharImage.astro';
---

<Base title="ページが見つかりません｜投資家16タイプ診断" noindex>
  <section class="pt-12 text-center">
    <CharImage code="SDFT" alt="" sizes="160px" eager class="mx-auto w-40 rounded-3xl" />
    <h1 class="mt-5 text-xl font-bold">ページが見つかりません</h1>
    <p class="mt-2 text-sm text-ink-soft">URLが変わったか、削除された可能性があります。</p>
    <a href="/" class="mt-6 inline-flex min-h-12 w-full max-w-xs items-center justify-center rounded-full bg-clay font-bold text-paper">トップへ戻る</a>
  </section>
</Base>
