---
import Base from '../layouts/Base.astro';
import CharImage from '../components/CharImage.astro';
import TypeGrid from '../components/TypeGrid.astro';
import { AXES } from '../lib/axes';

const heroes = ['QBRW', 'PGIW', 'PBIW'];
---

<Base title="投資家16タイプ診断｜日常の32問で、投資したらどのタイプか分かる">
  <!-- キャッチ -->
  <section class="pt-8 text-center">
    <div class="flex items-end justify-center -space-x-4">
      {heroes.map((c, i) => (
        <CharImage code={c} alt="" sizes="128px" eager class:list={['rounded-3xl border-4 border-paper', i === 1 ? 'w-32' : 'w-24']} />
      ))}
    </div>
    <h1 class="mt-6 text-[1.7rem] font-bold leading-snug">日常の32問でわかる<br />あなたが投資したら、<br class="sm:hidden" />どのタイプ？</h1>
    <p class="mt-3 text-ink-soft">買い物・旅行・食事の質問に答えるだけ。<br />投資の知識はいりません。</p>
    <a href="/test" class="mt-7 inline-flex min-h-14 w-full max-w-xs items-center justify-center rounded-full bg-clay text-lg font-bold text-paper shadow-sm active:translate-y-px">診断を始める</a>
    <ul class="mt-4 flex justify-center gap-4 text-xs text-ink-soft">
      <li>全32問</li>
      <li>約3分</li>
      <li>登録不要</li>
    </ul>
  </section>

  <!-- 4つの軸 -->
  <section class="mt-14">
    <h2 class="text-center text-lg font-bold">4つのものさしで16タイプに分かれます</h2>
    <ul class="mt-5 grid grid-cols-2 gap-3">
      {AXES.map((a) => (
        <li class="rounded-3xl bg-paper-deep px-4 py-4 text-center">
          <p class="text-xs font-bold text-ink-soft">{a.label}</p>
          <p class="mt-2 font-bold">
            <span class="text-clay">{a.left.letter}</span> {a.left.label}
            <span class="mx-1 text-ink-soft">/</span>
            <span class="text-sage">{a.right.letter}</span> {a.right.label}
          </p>
        </li>
      ))}
    </ul>
    <p class="mt-4 text-center text-sm text-ink-soft">4文字を並べたものが、あなたのタイプコードになります（例：QBRW）。</p>
  </section>

  <!-- 16キャラ -->
  <section class="mt-14">
    <h2 class="text-center text-lg font-bold">16タイプのキャラクター</h2>
    <p class="mt-1 text-center text-xs text-ink-soft">タップすると、くわしい解説を読めます</p>
    <div class="mt-5">
      <TypeGrid />
    </div>
  </section>

  <section class="mt-12 text-center">
    <a href="/test" class="inline-flex min-h-14 w-full max-w-xs items-center justify-center rounded-full bg-clay text-lg font-bold text-paper shadow-sm active:translate-y-px">診断を始める</a>
    <p class="mt-3 text-xs text-ink-soft">回答はあなたのブラウザの中だけで処理され、送信されません。</p>
  </section>
</Base>
