---
// TODO（フェーズ3）：有料レポート（Stripe の決済リンク）に差し替える
import Base from '../../layouts/Base.astro';
import CharImage from '../../components/CharImage.astro';
import { TYPES, typePageUrl, type InvestorType } from '../../lib/types';

export function getStaticPaths() {
  return TYPES.map((t) => ({ params: { code: t.code.toLowerCase() }, props: { type: t } }));
}
const { type } = Astro.props as { type: InvestorType };
---

<Base title={`${type.code} ${type.name}のくわしいレポート（準備中）｜投資家16タイプ診断`} noindex>
  <section class="pt-10 text-center">
    <CharImage code={type.code} alt="" sizes="160px" eager class="mx-auto w-40 rounded-3xl" />
    <h1 class="mt-5 text-xl font-bold">{type.code} {type.name}の<br />くわしいレポート</h1>
    <p class="mt-3 inline-block rounded-full bg-paper-deep px-4 py-1 text-sm font-bold text-clay">ただいま準備中です</p>
    <p class="mt-4 text-sm leading-relaxed text-ink-soft">公開までは、無料のタイプ解説をご覧ください。</p>
    <a href={typePageUrl(type.code)} class="mt-6 inline-flex min-h-12 w-full max-w-xs items-center justify-center rounded-full bg-clay font-bold text-paper">{type.name}の解説を読む</a>
  </section>
</Base>
