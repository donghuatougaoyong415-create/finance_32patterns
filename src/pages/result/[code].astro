---
import Base from '../../layouts/Base.astro';
import { AXES } from '../../lib/axes';
import CharImage from '../../components/CharImage.astro';
import { TYPES, getType, typePageUrl, type InvestorType } from '../../lib/types';
import { xShareText } from '../../lib/share';

export function getStaticPaths() {
  return TYPES.map((t) => ({ params: { code: t.code }, props: { type: t } }));
}

const { type } = Astro.props as { type: InvestorType };
const compat = getType(type.compatible)!;
const shareUrl = new URL(`/result/${type.code}`, Astro.site).href;
const text = xShareText(type);
const xUrl = `https://x.com/intent/post?text=${encodeURIComponent(text)}&url=${encodeURIComponent(shareUrl)}`;
const lineUrl = `https://social-plugins.line.me/lineit/share?url=${encodeURIComponent(shareUrl)}`;
const topUrl = new URL('/', Astro.site).href;
const xFollowUrl = import.meta.env.PUBLIC_X_URL as string | undefined;

const title = `${type.code} ${type.name}｜投資家16タイプ診断`;
const description = `日常のあなた：${type.daily}。投資したら：${type.invest}。`;
---

<Base title={title} description={description} ogImage={`/og/${type.code}.png`}>
  <!-- 1. キャラ画像とタイプ名 -->
  <section class="pt-6 text-center">
    <CharImage code={type.code} alt={type.name} sizes="(max-width: 400px) 256px, 320px" eager class="mx-auto w-64 rounded-[2rem] sm:w-80" />
    <p class="mt-4 text-sm text-ink-soft">あなたは</p>
    <h1 class="mt-1 text-2xl font-bold">【<span class="tracking-wider">{type.code}</span> {type.name}】</h1>
  </section>

  <!-- 2. 日常のあなた → 投資したら -->
  <section class="mt-6 rounded-3xl bg-paper-deep px-5 py-5">
    <p class="text-xs font-bold text-ink-soft">日常のあなた</p>
    <p class="mt-1 leading-relaxed">{type.daily}</p>
    <p class="my-2 text-center text-xl text-clay" aria-hidden="true">↓</p>
    <p class="text-xs font-bold text-clay">投資したら</p>
    <p class="mt-1 text-lg font-bold leading-relaxed">{type.invest}</p>
  </section>

  <!-- 3. 4軸のバー（?s= があるときだけ表示） -->
  <section id="axes" class="mt-6 hidden space-y-4" data-code={type.code}>
    <h2 class="text-sm font-bold text-ink-soft">あなたの傾き</h2>
    {AXES.map((a, i) => (
      <div data-axis-index={i}>
        <div class="flex justify-between text-xs text-ink-soft">
          <span data-side="left">{a.left.label}</span>
          <span data-side="right">{a.right.label}</span>
        </div>
        <div class="mt-1 h-3 overflow-hidden rounded-full bg-sage/30">
          <div class="h-full rounded-full bg-clay" data-bar style="width: 50%"></div>
        </div>
      </div>
    ))}
  </section>

  <!-- 4. シェア -->
  <section class="mt-8">
    <h2 class="text-center text-sm font-bold text-ink-soft">結果をシェア</h2>
    <div class="mt-3 grid grid-cols-3 gap-2">
      <a href={xUrl} target="_blank" rel="noopener" data-track="share_click" data-track-channel="x" class="flex min-h-12 items-center justify-center rounded-full bg-ink text-sm font-bold text-paper">Xでシェア</a>
      <a href={lineUrl} target="_blank" rel="noopener" data-track="share_click" data-track-channel="line" class="flex min-h-12 items-center justify-center rounded-full bg-sage text-sm font-bold text-paper">LINEで送る</a>
      <button type="button" id="copy" data-url={shareUrl} data-track="share_click" data-track-channel="copy" class="min-h-12 rounded-full border border-line text-sm font-bold">リンクをコピー</button>
    </div>
  </section>

  <!-- 5. 強み・やりがちな失敗・相性◎ -->
  <section class="mt-8 space-y-3">
    <div class="rounded-3xl border border-line px-5 py-4">
      <h2 class="text-xs font-bold text-sage">強み</h2>
      <p class="mt-1">{type.strength}</p>
    </div>
    <div class="rounded-3xl border border-line px-5 py-4">
      <h2 class="text-xs font-bold text-clay">やりがちな失敗</h2>
      <p class="mt-1">{type.pitfall}</p>
    </div>
    <a href={typePageUrl(compat.code)} class="flex items-center gap-4 rounded-3xl border border-line px-5 py-4">
      <CharImage code={compat.code} alt="" sizes="64px" class="size-16 shrink-0 rounded-2xl" />
      <div>
        <h2 class="text-xs font-bold text-mustard">相性◎</h2>
        <p class="mt-1 font-bold">{compat.code} {compat.name}</p>
        <p class="text-xs text-ink-soft">ペースが合い、弱点を補い合う相手</p>
      </div>
    </a>
  </section>

  <!-- 6. 有料レポート案内（フェーズ3） -->
  <!-- 7. タイプ向けサービス紹介・PR（フェーズ3） -->

  <!-- 8. 運営者のXへのフォロー導線 -->
  {xFollowUrl && (
    <section class="mt-8 text-center">
      <a href={xFollowUrl} target="_blank" rel="noopener" class="inline-flex min-h-12 items-center rounded-full border border-ink px-6 text-sm font-bold">運営者のXをフォロー</a>
    </section>
  )}

  <!-- 9. 広告枠（フェーズ3） -->

  <!-- 10. もう一度・友達に -->
  <section class="mt-10 grid gap-3">
    <a href="/test" class="flex min-h-12 items-center justify-center rounded-full bg-clay font-bold text-paper">もう一度診断する</a>
    <button type="button" id="invite" data-url={topUrl} class="min-h-12 rounded-full border border-line font-bold">友達にも診断してもらう</button>
  </section>
</Base>

<script>
  import { AXES } from '../../lib/axes';
  import { parseStrengths } from '../../lib/scoring';
  import { track } from '../../lib/analytics';

  // 4軸のバー
  const section = document.getElementById('axes')!;
  const code = section.dataset.code!;

  // 診断を終えて来たときだけ test_complete を送る（シェアされたURLを開いた人は数えない）
  try {
    if (sessionStorage.getItem('investor16:completed') === code) {
      track('test_complete', { type: code });
      sessionStorage.removeItem('investor16:completed');
    }
  } catch {
    /* ignore */
  }

  const strengths = parseStrengths(new URLSearchParams(location.search).get('s'));
  if (strengths) {
    AXES.forEach((axis, i) => {
      const row = section.querySelector<HTMLElement>(`[data-axis-index="${i}"]`)!;
      const isLeft = code[i] === axis.left.letter;
      const pct = strengths[i];
      const leftShare = isLeft ? pct : 100 - pct;
      row.querySelector<HTMLElement>('[data-bar]')!.style.width = `${leftShare}%`;
      const win = row.querySelector<HTMLElement>(`[data-side="${isLeft ? 'left' : 'right'}"]`)!;
      win.textContent = `${isLeft ? axis.left.label : axis.right.label} ${pct}%`;
      win.classList.add('font-bold', 'text-ink', 'text-sm');
    });
    section.classList.remove('hidden');
  }

  async function copy(btn: HTMLButtonElement, done: string) {
    const url = btn.dataset.url!;
    const original = btn.textContent;
    try {
      await navigator.clipboard.writeText(url);
      btn.textContent = done;
    } catch {
      window.prompt('このリンクをコピーしてください', url);
    }
    setTimeout(() => (btn.textContent = original), 2000);
  }

  const copyBtn = document.getElementById('copy') as HTMLButtonElement;
  copyBtn.addEventListener('click', () => copy(copyBtn, 'コピーしました'));

  const invite = document.getElementById('invite') as HTMLButtonElement;
  invite.addEventListener('click', async () => {
    const url = invite.dataset.url!;
    if (navigator.share) {
      try {
        await navigator.share({ title: '投資家16タイプ診断', text: '日常の32問で、投資したらどのタイプか分かるよ', url });
        return;
      } catch {
        /* キャンセル時はコピーにフォールバックしない */
        return;
      }
    }
    copy(invite, 'リンクをコピーしました');
  });
</script>
