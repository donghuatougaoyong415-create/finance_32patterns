{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/result/:old(SANT|sant)",
      "destination": "/result/QBRW",
      "statusCode": 301
    },
    {
      "source": "/types/:old(SANT|sant)",
      "destination": "/types/qbrw",
      "statusCode": 301
    },
    {
      "source": "/report/:old(SANT|sant)",
      "destination": "/report/qbrw",
      "statusCode": 301
    },
    {
      "source": "/og/:old(SANT|sant).png",
      "destination": "/og/QBRW.png",
      "statusCode": 301
    },
